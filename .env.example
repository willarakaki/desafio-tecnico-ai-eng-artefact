# ==============================================================================
# Empório da Música Intelligent Assistant — Environment Configuration Template
# Copy this file to `.env` and fill in the API key for your active LLM_PROVIDER.
# ==============================================================================

# Active LLM Provider: "gemini" | "openai" | "ollama"
LLM_PROVIDER=gemini

# --- Google Gemini Settings ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_SYNTHESIZER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- OpenAI Settings (Optional alternative provider) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_SYNTHESIZER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama Settings (Optional local open-weights provider) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ROUTER_MODEL=qwen2.5:7b
OLLAMA_SYNTHESIZER_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- LangSmith Distributed Tracing (Optional Observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=emporio-da-musica-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Defense-in-Depth & Context-Aware Semantic Cache ---
SEMANTIC_CACHE_THRESHOLD=0.92
RATE_LIMIT_MAX_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60
MAX_INPUT_CHARS=2000

# --- Observability & Data Paths ---
DATA_DIR=data
LOG_LEVEL=INFO
